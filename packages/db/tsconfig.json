{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "module": "ESNext",
    "target": "ES2023",
    "lib": ["ES2023"],
    "moduleResolution": "bundler",
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "prisma/**/*.ts", "generated/**/*.ts", "prisma.config.ts"],
  "exclude": ["node_modules", "dist"]
}
