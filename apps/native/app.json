{
  "expo": {
    "name": "Exterior Pro",
    "slug": "exterior-pro-field",
    "version": "1.0.0",
    "scheme": "exteriorpro",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#070B12"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.exteriorpro.field"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#070B12"
      },
      "package": "com.exteriorpro.field"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Exterior Pro to access your photos so you can attach before and after job pictures.",
          "cameraPermission": "Allow Exterior Pro to use the camera to take before and after job pictures."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#84CC16",
          "sounds": ["./assets/notification-sound.wav"]
        }
      ],
      "expo-font",
      "expo-splash-screen"
    ]
  }
}
