{
  "expo": {
    "name": "Exterior Pro",
    "slug": "exterior-pro-stack",
    "version": "1.0.0",
    "scheme": "exteriorpro",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#070B12"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.exteriorpro.field"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#070B12"
      },
      "package": "com.exteriorpro.field",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Exterior Pro to access your photos so you can attach before and after job pictures.",
          "cameraPermission": "Allow Exterior Pro to use the camera to take before and after job pictures."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#C8F542"
        }
      ],
      "expo-font",
      "expo-maps",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070B12",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "71b14fb3-bc3d-4e8b-aaf8-bbcf826cae9e"
      }
    },
    "owner": "straddle"
  }
}
