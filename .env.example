# Database (MySQL)
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/exterior_pro"

# Auth
JWT_SECRET="replace-with-a-long-random-secret"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
CRON_SECRET="replace-with-a-random-cron-secret"

# Stripe — TEST MODE until the final live cutover.
# Do not put live keys here until company identity, insurance, and product P0 are done.
STRIPE_SECRET_KEY="rk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Platform take rate in basis points (1000 = 10%)
PLATFORM_FEE_BPS="1000"

# Email (Brevo) — used for login codes and transactional email.
# BREVO_FROM must be a sender verified in the Brevo dashboard.
BREVO_API_KEY=""
BREVO_FROM="Exterior Pro <noreply@yourdomain.com>"

# Vercel Blob (job photos, provider logos, cached property exterior photos)
BLOB_READ_WRITE_TOKEN=""
BLOB_STORE_ID=""

# Google Maps Platform — property card exterior photos.
# Enable "Street View Static API" and "Maps Static API" on the key.
# Fetched once per address and mirrored to Blob, so usage is one call per
# property rather than per page view. Leave blank to fall back to the
# illustrated placeholder.
GOOGLE_MAPS_API_KEY=""

# Native / Expo (production EAS builds)
EXPO_PUBLIC_API_URL="https://exteriorpro.app"
# Server token for sending Expo push notifications
EXPO_ACCESS_TOKEN=""

# Error tracking (Sentry)
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
